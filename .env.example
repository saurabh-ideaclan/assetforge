# Copy to .env (never committed) and fill in. AssetForge reads, in order: the process environment,
# ./.env in the repo you run it from, then $ASSETFORGE_HOME/.env.

# Image generation keys (only image generation calls paid APIs; audio is all local).
OPENAI_API_KEY=
GEMINI_API_KEY=
# Alternative name for the Gemini key.
GOOGLE_API_KEY=

# Optional: preferred provider (openai or gemini) and model overrides.
ASSETFORGE_IMAGE_PROVIDER=
ASSETFORGE_OPENAI_IMAGE_MODEL=
ASSETFORGE_OPENAI_EDIT_MODEL=
ASSETFORGE_GEMINI_IMAGE_MODEL=
ASSETFORGE_GEMINI_EDIT_MODEL=

# Offline fake provider for testing (1 = on). Never falls back to paid providers.
ASSETFORGE_ENABLE_FAKE_PROVIDER=
